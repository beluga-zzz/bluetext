{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bluetext",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // relay.marmot.to is a Cloudflare Tunnel on this same zone. Without this flag,
  // same-zone fetch() skips the public route and times out (HTTP 522).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bluetext",
      "database_id": "d9bf1abe-7bfa-452e-aa17-bd56aead13ef"
    }
  ],
  "observability": { "enabled": true }
}
