{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bluetext",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // relay.marmot.to is a Cloudflare Tunnel on this same zone. Without this flag,
  // same-zone fetch() skips the public route and times out (HTTP 522).
  "compatibility_flags": ["global_fetch_strictly_public"],
  // app.b2blue.chat = the app. b2blue.chat = the landing page (public/site/).
  // The two marmot.to routes are the old addresses: pages redirect, webhook URLs still work.
  "routes": [
    { "pattern": "app.b2blue.chat", "custom_domain": true },
    { "pattern": "b2blue.chat", "custom_domain": true },
    { "pattern": "www.b2blue.chat", "custom_domain": true },
    { "pattern": "bluetext.marmot.to", "custom_domain": true },
    { "pattern": "marmot.to/bluetext*", "zone_name": "marmot.to" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bluetext",
      "database_id": "d9bf1abe-7bfa-452e-aa17-bd56aead13ef"
    }
  ],
  // Sends queued B2Blue texts and checks delivery every minute.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
